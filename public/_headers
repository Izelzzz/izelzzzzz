# Workers static assets. Same security headers as lib/security-headers.js.
# Regenerate with: node scripts/sync-public-headers.js

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; frame-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; img-src 'self' data: blob: https://*.unsplash.com https://*.imgix.net https://imgix.net https://*.imgix.com https://imgix.com https://*.notion.so https://notion.so https://*.notion.com https://*.notion-static.com https://prod-files-secure.s3.us-west-2.amazonaws.com

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
